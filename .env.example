# Feishu (Lark) API Configuration
# ================================
# Required for uploading reports to Feishu documents.
# Get these credentials from: https://open.feishu.cn/app/

# Your Feishu app ID
FEISHU_APP_ID=your_app_id_here

# Your Feishu app secret
FEISHU_APP_SECRET=your_app_secret_here

# (Optional) Default folder token to upload documents
# If not specified, documents will be created in the root directory
FEISHU_FOLDER_TOKEN=your_folder_token_here
